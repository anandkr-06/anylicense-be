<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Contact Inquiry Submitted</title>
</head>
<body style="margin:0; padding:0; background:#f4f4f4; font-family: Arial, Helvetica, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f4; padding:20px 0;">
    <tr>
      <td align="center">
        <table width="650" cellpadding="0" cellspacing="0" 
          style="background:#ffffff; border:12px solid #f4b400; border-radius:18px; padding:40px;">

          <tr>
            <td style="font-size:18px; color:#333; padding-bottom:20px;">
              Hi {{receiverName}},
            </td>
          </tr>

          <tr>
            <td style="font-size:16px; color:#555; padding-bottom:25px;">
              A new contact enquiry has been submitted through the platform.
            </td>
          </tr>

          <tr>
            <td style="padding-bottom:12px;">
              <strong>Submitted By:</strong> {{submittedBy}}
            </td>
          </tr>

          <tr>
            <td style="padding-bottom:12px;">
              <strong>Inquiry Type:</strong> {{inquiryType}}
            </td>
          </tr>

          <tr>
            <td style="padding-bottom:12px;">
              <strong>Name:</strong> {{firstName}} {{lastName}}
            </td>
          </tr>

          <tr>
            <td style="padding-bottom:12px;">
              <strong>Email:</strong> {{email}}
            </td>
          </tr>

          <tr>
            <td style="padding-bottom:12px;">
              <strong>Phone:</strong> {{phone}}
            </td>
          </tr>

          <tr>
            <td style="padding-bottom:12px;">
              <strong>Message:</strong>
            </td>
          </tr>

          <tr>
            <td 
              style="background:#f9f9f9; border:1px solid #ddd; border-radius:8px; padding:18px; color:#444; line-height:1.6; white-space:pre-line;">
              {{message}}
            </td>
          </tr>

          <tr>
            <td align="center" style="padding-top:35px;">
              <a href="https://static.anylicence.com/media/{{website_url}}" 
                 style="background:#000; color:#fff; text-decoration:none; padding:14px 36px; border-radius:8px; font-weight:bold; display:inline-block;">
                 Visit Platform
              </a>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>