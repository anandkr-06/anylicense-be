<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to AnyLicence</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f4; font-family: Arial, Helvetica, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f4f4f4">
    <tr>
      <td align="center" style="padding:20px 0;">

        <!-- Main Container -->
        <table width="600" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="border-collapse:collapse;">

          <!-- Header -->
          <tr>
            <td style="background-color:#3a3a3a; padding:15px 30px 5px;"><img style="width:140px; height:auto" src="https://static.anylicence.com/media/statics/logo.png" alt="Any Licence" />
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:25px 30px; color:#333333; font-size:14px; line-height:1.6;">

              <p style="margin:0 0 15px;">
                <strong>Hi {{firstName}},</strong>
              </p>

              <p style="margin:0 0 15px;">
                Thank you for sharing your details with us:
              </p>

              <p style="margin:0 0 20px;">
                We have successfully cpatured your information and you are now being redirected to our trusted third party partner website to continue the next step of your process.
              </p>

              <p style="margin:0 0 10px;">
                <strong>Your Submitted Details:</strong>
              </p>

              <ol style="padding-left:18px; margin:0 0 20px;">
                <li style="margin-bottom:8px;">
                  Name:{{firstName}} {{lastName}}
                </li>
                <li style="margin-bottom:8px;">
                  Email:{{email}}
                </li>
                <li style="margin-bottom:8px;">
                  Phone:{{phone}}
                </li>
                <li style="margin-bottom:8px;">
                  Suburb:{{suburb}}
                </li>
                <li style="margin-bottom:8px;">
                  Submitted On: {{submittedAt}}
                </li>

              </ol>

              <p style="margin:0 0 15px;">
                If you have any questions or require assistance, please contact us at
                <a href="mailto:{{support_email}}" style="color:#ff9800; text-decoration:none;">
                  {{support_email}}</a>.
              </p>
              <p style="margin:0 0 25px;">
                We wish you a safe and successful learning course experience.
              </p>

              <p style="margin:0;">
                <strong>Sincerely,</strong><br />
                Team AnyLicence<br />
                <a href="{{website_url}}" style="color:#ff9800; text-decoration:none;">
                  {{website_name}}
                </a>
              </p>

            </td>
          </tr>

          <tr>
            <td style="background-color:#ffb300; height:5px; font-size:0px"></td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>