<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Slot Cancelled</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f4f4; font-family: Arial, Helvetica, sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f4f4f4">
<tr>
<td align="center" style="padding:20px 0;">

<table width="600" cellpadding="0" cellspacing="0" bgcolor="#ffffff">

<!-- Header -->
<tr>
<td style="background-color:#3a3a3a; padding:15px 30px;">
  <img src="https://static.anylicence.com/media/statics/logo.png" style="width:140px;" />
</td>
</tr>

<!-- Body -->
<tr>
<td style="padding:25px 30px; color:#333; font-size:14px; line-height:1.6;">

<p><strong>Hi {{receiverName}},</strong></p>

<p>
Your session has been 
<strong style="color:#e53935;">cancelled</strong>.
</p>

<p>
Here are the details for your reference:
</p>

<p><strong>📅 Date:</strong> {{slotDate}}</p>
<p><strong>⏰ Time:</strong> {{startTime}} - {{endTime}}</p>
<p><strong>👤 Cancelled By:</strong> {{actedBy}}</p>

{{#if comment}}
<p><strong>📝 Note:</strong> {{comment}}</p>
{{/if}}

<!-- ✅ Refund / Policy Messages -->

{{#if isEarlyCancel}}
<div style="background:#f1f8e9; border-left:4px solid #7cb342; padding:12px; margin:18px 0;">
  <strong>Refund Update:</strong><br/>
  This cancellation was made more than 24 hours before the scheduled session.
  Eligible refund amount (if applicable) has been processed to the learner wallet.
</div>
{{/if}}

{{#if isInstructorLateCancel}}
<div style="background:#fff3e0; border-left:4px solid #fb8c00; padding:12px; margin:18px 0;">
  <strong>Important Notice:</strong><br/>
  This booking was cancelled by the instructor within 24 hours of the scheduled session.
  No refund has been issued to the learner. Please verify with support if required.
</div>
{{/if}}

{{#if isLearnerLateCancel}}
<div style="background:#ffebee; border-left:4px solid #e53935; padding:12px; margin:18px 0;">
  <strong>Refund Policy Notice:</strong><br/>
  This booking was cancelled by the learner within 24 hours of the scheduled session.
  As per policy, no refund has been issued.
</div>
{{/if}}

<p>
If you wish to book another session, feel free to visit our platform anytime.
</p>

<p style="margin-top:20px;">
<strong>Team AnyLicence</strong><br/>
<a href="{{website_url}}" style="color:#ff9800; text-decoration:none;">
  {{website_url}}
</a>
</p>

</td>
</tr>

<tr>
<td style="background-color:#ffb300; height:5px;"></td>
</tr>

</table>

</td>
</tr>
</table>

</body>
</html>
